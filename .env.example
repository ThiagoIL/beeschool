# ---------- Obrigatórias ----------
# Banco PostgreSQL (no Easypanel, copie a "Internal Connection URL" do serviço Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bee_school"
# Domínio principal, sem https e sem barra. A escola abre em <INITIAL_TENANT_SLUG>.ROOT_DOMAIN e o console em admin.ROOT_DOMAIN.
# Em desenvolvimento use localhost:3000 (abra beeschool.localhost:3000 e admin.localhost:3000)
ROOT_DOMAIN="localhost:3000"
# Chave para cifrar os segredos do 2FA. Gere uma vez (ex.: openssl rand -base64 48) e NUNCA troque depois de em uso.
APP_SECRET=""

# ---------- Primeira subida (bootstrap idempotente; apague as senhas depois) ----------
# Conta master do console do fornecedor
INITIAL_ADMIN_NAME="Seu Nome"
INITIAL_ADMIN_EMAIL="voce@seudominio.com.br"
INITIAL_ADMIN_PASSWORD=""
# Instalação única: o cliente (a escola) e o primeiro administrador dele
INITIAL_TENANT_SLUG="beeschool"
INITIAL_TENANT_NAME="Bee School & Bee Light"
INITIAL_TENANT_ADMIN_NAME="Diretoria"
INITIAL_TENANT_ADMIN_EMAIL=""
INITIAL_TENANT_ADMIN_PASSWORD=""

# ---------- E-mail (recuperação de senha) ----------
# Sem SMTP_HOST, em desenvolvimento o link aparece no log; em produção o e-mail não é enviado.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="Bee School <nao-responda@seudominio.com.br>"
PASSWORD_RESET_MINUTES="60"

# ---------- Opcionais ----------
ADMIN_SUBDOMAIN="admin"
# Cookies só por HTTPS (padrão true em produção). Use false apenas em desenvolvimento local.
COOKIE_SECURE="false"
SESSION_HOURS="12"
SESSION_IDLE_MINUTES="120"
# Confiar no IP informado pelo proxy (Traefik do Easypanel). Mantenha true atrás do Easypanel.
TRUST_PROXY="true"
APP_TIMEZONE="America/Sao_Paulo"
# Conexões com o banco por instância (use 1 com o banco de desenvolvimento PGlite)
DATABASE_POOL_MAX="10"
