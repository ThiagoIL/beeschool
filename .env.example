# ---------- Obrigatórias ----------
# Banco PostgreSQL (no Easypanel, copie a "Internal Connection URL" do serviço Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bee_school"
# Chave das sessões e dos links de senha (mínimo 32 caracteres; gere com: openssl rand -base64 48).
# Trocar desconecta todo mundo (escola e console) — útil se suspeitar de vazamento.
AUTH_SECRET=""

# ---------- Primeira subida (bootstrap idempotente; apague as senhas depois) ----------
# Conta master do console do fornecedor (abre em https://seu-dominio/sistema-admin)
PLATFORM_ADMIN_NAME="Seu Nome"
PLATFORM_ADMIN_EMAIL="voce@seudominio.com.br"
PLATFORM_ADMIN_PASSWORD=""
# Primeiro administrador da escola (troca a senha no primeiro acesso)
ADMIN_NAME="Diretoria"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---------- E-mail (recuperação de senha da escola) ----------
# Sem SMTP_HOST, em desenvolvimento o link aparece no log; em produção o e-mail não é enviado.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="Bee School <nao-responda@seudominio.com.br>"
PASSWORD_RESET_MINUTES="60"

# ---------- Opcionais ----------
# Caminho do console do fornecedor no mesmo domínio (padrão /sistema-admin). Escolha algo pouco óbvio.
PLATFORM_ADMIN_PATH="/sistema-admin"
# Endereço público usado nos links dos e-mails (sem ele, usa o domínio acessado)
APP_URL=""
# Cookies só por HTTPS (padrão true em produção). Use false apenas em desenvolvimento local.
COOKIE_SECURE="false"
SESSION_HOURS="12"
SESSION_IDLE_MINUTES="120"
# Confiar no IP informado pelo proxy (Traefik do Easypanel). Mantenha true atrás do Easypanel.
TRUST_PROXY="true"
APP_TIMEZONE="America/Sao_Paulo"
# Conexões com o banco por instância (use 1 com o banco de desenvolvimento PGlite)
DATABASE_POOL_MAX="10"
