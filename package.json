{
  "name": "bee-school",
  "version": "0.1.0",
  "private": true,
  "description": "Bee School — gestão escolar (financeiro, painéis e acadêmico)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:bootstrap": "node scripts/bootstrap.mjs",
    "db:dev": "node scripts/dev-db.mjs ./.pgdata",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "next": "15.5.27",
    "nodemailer": "^6.10.1",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@electric-sql/pglite-socket": "^0.0.15",
    "@types/node": "22.18.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.15.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
